@article{haas_novo_2026,
	title = {De novo design of protein nanoparticles with integrated functional motifs},
	issn = {2692-8205},
	url = {https://pmc.ncbi.nlm.nih.gov/articles/PMC12776285/},
	doi = {10.64898/2025.12.19.695620},
	abstract = {Computational design of self-assembling proteins has long relied on pre-existing structures and sequences, fundamentally limiting control over their structural and functional properties. Recent machine learning-based methods have transformed our ability to design functional small de novo proteins and oligomers, yet methods to design large de novo protein assemblies with structures tailored to specific applications are still underexplored. Here, we develop a generalizable method for designing de novo symmetric protein complexes that incorporate target functional motifs into their structures. We report 34 new protein nanoparticles that form on-target assemblies with cubic point group symmetries. The nanoparticles exhibit a wide variety of backbones that were designed with atom-level accuracy, as evidenced by several cryo-EM and crystal structures that reveal minimal deviations from the design models. We use the method to generate a de novo antigen-tailored nanoparticle vaccine that elicits robust immune responses in mice. These results establish a generalizable approach that can be used to design functional self-assembling protein complexes with structures tailored to specific applications.},
	urldate = {2026-04-23},
	journal = {bioRxiv},
	author = {Haas, Cyrus M. and Rankovic, Sanela and Lewis, Hanul K. and Carr, Kenneth D. and Weidle, Connor and Gerdes, Sophie S. and Nuss, Lily R. and Ruiz, Felicitas and Moiz, Syed and Fiorelli, Maggie and Grey, Emily and McGowan, Jackson and Kumar, Nikhila and Creanga, Adrian and Kang, Alex and Nguyen, Hannah and Wang, Yanqing and Sankaran, Banumathi and Dosey, Annie and Ravichandran, Rashmi and Bera, Asim K. and Leaf, Elizabeth M. and DeForest, Cole A. and Kanekiyo, Masaru and Borst, Andrew J. and King, Neil P.},
	month = jan,
	year = {2026},
	pages = {2025.12.19.695620},
}

